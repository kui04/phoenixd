# Layer 1 settings for the Docker daemon.

# The static binaries of the v1 bundle run here. Alpine's containerd 2.3.7
# loops on the pidfd probe of kernel 4.14, and the bundle ships containerd
# 2.4.2, which does not. dockerd finds containerd and runc next to itself.
DOCKERD_BINARY="/opt/phoenixd/docker-bin/dockerd"
PATH="/opt/phoenixd/docker-bin:/opt/phoenixd/bin:${PATH}"
export PATH

# The legacy iptables names come first: Alpine's iptables package is nft and
# this kernel has no nf_tables.
PATH="/opt/phoenixd/bin:${PATH}"
export PATH

# Keep the log budget small: /var/log lives on the loop image.
LOGPROXY_ROTATION_SIZE=8388608
LOGPROXY_ROTATED_FILES=3

# overlay2 keeps the v1 data visible. Docker 29 makes the containerd image
# store the default for new installs, so it is turned off explicitly.
# The exec root and the pid file stay on the /run tmpfs with plain paths, so
# neither dockerd nor containerd resolves them through the /var/run bind.
DOCKER_OPTS="--data-root=/var/lib/docker --exec-root=/run/docker-exec --pidfile=/run/docker.pid --storage-driver=overlay2 --feature containerd-snapshotter=false --ip6tables=false"
